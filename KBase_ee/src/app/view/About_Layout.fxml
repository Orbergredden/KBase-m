<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="430.0" prefWidth="380.0" spacing="6.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.view.About_Controller">
	<children>
		<ImageView fx:id="imageView_AppIcon" fitHeight="96.0" fitWidth="96.0" preserveRatio="true" />
		<Label fx:id="label_AppName" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="KBase-ee" />
		<Label fx:id="label_Version" text="Версія:" />
		<Label fx:id="label_Date" text="" />
		<Label fx:id="label_CodeName" text="" />
		<Separator prefWidth="280.0" />
		<Label fx:id="label_Author" text="Автор:" />
		<Hyperlink fx:id="hyperlink_Site" onAction="#handleSiteLink" text="Сайт" />
		<Button fx:id="button_Close" defaultButton="true" mnemonicParsing="false" onAction="#handleButtonClose" prefWidth="140.0" text="Закрити" />
	</children>
	<padding>
		<Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
	</padding>
</VBox>
