      <mxCell id="wffY_vZNPe6HdAMju6R--5" parent="wffY_vZNPe6HdAMju6R--4" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=top;rounded=0;perimeterSpacing=1;dashed=1;dashPattern=1 4;" value="&lt;div style=&quot;font-family: Consolas; font-size: 10pt;&quot;&gt;&lt;span style=&quot;color:#646464&quot;&gt;@FXML&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#7f0055; font-weight:bold;&quot;&gt;private&lt;/span&gt; WebView &lt;span style=&quot;color:#0000c0;&quot;&gt;webView_current&lt;/span&gt;;&lt;br&gt;&lt;span style=&quot;color:#7f0055; font-weight:bold;&quot;&gt;private&lt;/span&gt; WebEngine &lt;span style=&quot;color:#00c000;&quot;&gt;webEngine&lt;/span&gt;;&lt;br&gt;&lt;span style=&quot;color: rgb(63, 127, 95);&quot;&gt;// флаг/іd для листенера – нужно ли переходить в документе на текущий инфо блок&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(127, 0, 85); font-weight: bold;&quot;&gt;private&lt;/span&gt; &lt;span style=&quot;color: rgb(127, 0, 85); font-weight: bold;&quot;&gt;long&lt;/span&gt; &lt;span style=&quot;color: rgb(0, 0, 192);&quot;&gt;isReloadedId&lt;/span&gt; = -1;&lt;/div&gt;" vertex="1">
