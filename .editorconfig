root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
tab_width = 4

[*.{java,xml,fxml,properties,sql,sh,js,ts,json,yml,yaml}]
indent_style = tab
tab_width = 4

[*.{bat,ps1}]
indent_style = tab
tab_width = 4
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
indent_style = tab
tab_width = 4
